    </item>
    <item>
      <title>1.6</title>
      <pubDate>Wed, 09 Sep 2026 20:53:12 +0200</pubDate>
      <sparkle:version>17</sparkle:version>
      <sparkle:shortVersionString>1.6</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Find the switcher and OBS on the network instead of typing their addresses. Both address fields in Settings now have a magnifier that lists the ATEMs and OBS instances it finds, with product names and versions — double-click one to fill the field.]]></description>
      <enclosure url="https://github.com/steijehillewaert/AtemStatus-releases/releases/download/v1.6/AtemStatus-1.6.zip"
                 length="1609897"
                 type="application/octet-stream"
                 sparkle:edSignature="1AZXek3opYILPgqreNCMRev8C6HzYBQ0LFGJRlUQeIkBaFNJp6N8jXSJPt783cTnemDBVYeBXyykot8Q14nvDw=="/>
    </item>
    <item>
      <title>1.5</title>
      <pubDate>Mon, 07 Sep 2026 20:56:36 +0200</pubDate>
      <sparkle:version>16</sparkle:version>
      <sparkle:shortVersionString>1.5</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[The app now reads the switcher's handshake verdict: when an ATEM is refusing controllers because all five of its control connections are taken, it says so plainly instead of flickering between connected and offline, and it backs off to one attempt every five seconds. Also fixes a healthy recording disk being labelled full.]]></description>
      <enclosure url="https://github.com/steijehillewaert/AtemStatus-releases/releases/download/v1.5/AtemStatus-1.5.zip"
                 length="1574716"
                 type="application/octet-stream"
                 sparkle:edSignature="DWhZt24JzAOfgnBcNcxnN6Haw8PleSLgjlGpm6fFNgeZo+pt0WvInD39/4SSfKxJwp3LbsGc2RKS0RcR3pKHDg=="/>
    </item>
    <item>
      <title>1.4</title>
      <pubDate>Mon, 07 Sep 2026 20:33:30 +0200</pubDate>
      <sparkle:version>15</sparkle:version>
      <sparkle:shortVersionString>1.4</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Fixes the web server refusing to come back after a port change or ticking the LAN box — it retries a busy port instead of failing for good, and reports it in plain words. The Live Activity on iPhone now shows the stream next to the recording.]]></description>
      <enclosure url="https://github.com/steijehillewaert/AtemStatus-releases/releases/download/v1.4/AtemStatus-1.4.zip"
                 length="1573031"
                 type="application/octet-stream"
                 sparkle:edSignature="WFbw0spVaIpDLbLFLLUNwaZohlh3KgMPaIA5xQ6NpVP8rfOXB43LkGmTv/qMuJ5tFiYovP0IbFUL2hMByZM0Cw=="/>
    </item>
    <item>
      <title>1.3</title>
      <pubDate>Mon, 07 Sep 2026 20:11:15 +0200</pubDate>
      <sparkle:version>12</sparkle:version>
      <sparkle:shortVersionString>1.3</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Reads OBS over obs-websocket: stream state, bitrate, network congestion, and dropped frames (network drops in the last minute as well as the running total, plus encoding and rendering lag). Settings now shows a live connection indicator for the switcher, the web server and OBS.]]></description>
      <enclosure url="https://github.com/steijehillewaert/AtemStatus-releases/releases/download/v1.3/AtemStatus-1.3.zip"
                 length="1571616"
                 type="application/octet-stream"
