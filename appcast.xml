    <item>
      <title>1.7</title>
      <pubDate>Wed, 09 Sep 2026 21:04:02 +0200</pubDate>
      <sparkle:version>18</sparkle:version>
      <sparkle:shortVersionString>1.7</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[Fixes the app filling up the switcher's five control connections. A socket teardown could feed itself and start a fresh session every second, and the browse scan probed switchers that had already answered.]]></description>
      <enclosure url="https://github.com/steijehillewaert/AtemStatus-releases/releases/download/v1.7/AtemStatus-1.7.zip"
